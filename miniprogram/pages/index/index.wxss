.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.list {
  margin-top: 20rpx;
}

.item {
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
}
