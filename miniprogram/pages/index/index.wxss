.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx 0;
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 18rpx 8rpx 36rpx;
}

.hero-kicker {
  color: #7c88a4;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.hero-title {
  margin-top: 8rpx;
  color: #1f2a44;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.status-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  color: #7a849b;
  font-size: 24rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #aab2c4;
}

.status-ready .status-dot { background: #3bc98d; }
.status-error { color: #d85a69; }
.status-error .status-dot { background: #ef6475; }

.retry-button,
.subscribe-button {
  margin: 0;
  border-radius: 999rpx;
  background: #eef0ff;
  color: #5d6bed;
  font-size: 23rpx;
  font-weight: 600;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(71, 82, 117, 0.08);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(66, 78, 120, 0.08);
}

.record-card { padding: 32rpx 28rpx 30rpx; }

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title,
.section-subtitle { display: block; }

.section-title {
  color: #26324b;
  font-size: 32rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 5rpx;
  color: #949daf;
  font-size: 23rpx;
}

.type-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 19%;
  min-height: 114rpx;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  background: #f5f6fa;
  color: #707b91;
  font-size: 22rpx;
  transition: all 0.2s ease;
}

.type-item-active {
  border-color: #7986f8;
  background: #f0f1ff;
  color: #5362dd;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(92, 107, 229, 0.13);
}

.type-icon {
  margin-bottom: 7rpx;
  font-size: 38rpx;
}

.form-area { margin-top: 30rpx; }

.field-label {
  margin: 23rpx 4rpx 10rpx;
  color: #606b82;
  font-size: 24rpx;
  font-weight: 600;
}

.input-field,
.picker-field,
.textarea-field {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid #e9ecf3;
  border-radius: 20rpx;
  background: #fafbfc;
  color: #26324b;
  font-size: 27rpx;
}

.input-field,
.picker-field {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-arrow {
  color: #9ca5b7;
  font-size: 38rpx;
}

.textarea-field {
  min-height: 118rpx;
  padding: 22rpx 24rpx;
  line-height: 1.55;
}

.time-row {
  display: flex;
  justify-content: space-between;
}

.time-picker { width: 48.5%; }

.picker-field.compact {
  justify-content: center;
  text-align: center;
}

.primary-button {
  height: 92rpx;
  margin-top: 34rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #6f7df6, #8e72e9);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 92rpx;
  box-shadow: 0 14rpx 28rpx rgba(100, 111, 230, 0.25);
}

.primary-button[disabled] {
  background: #c8cedc;
  color: #ffffff;
  box-shadow: none;
}

.history-section { margin-top: 42rpx; }
.history-heading { padding: 0 8rpx 18rpx; }

.record-count {
  color: #7d879c;
  font-size: 23rpx;
}

.history-item {
  display: flex;
  margin-bottom: 16rpx;
  padding: 25rpx 24rpx;
  border: 1rpx solid rgba(71, 82, 117, 0.07);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(66, 78, 120, 0.05);
}

.history-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: #f1f2ff;
  font-size: 34rpx;
}

.history-content {
  flex: 1;
  min-width: 0;
}

.history-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-title {
  color: #303b53;
  font-size: 28rpx;
  font-weight: 700;
}

.history-time {
  color: #9aa3b5;
  font-size: 22rpx;
}

.history-description,
.history-note {
  display: block;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.history-description {
  color: #59647b;
  font-size: 25rpx;
}

.history-note {
  color: #8b94a7;
  font-size: 23rpx;
}

.loading-state,
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  border: 2rpx dashed #dde1ec;
  border-radius: 28rpx;
  color: #8e98ac;
}

.empty-state { flex-direction: column; }
.empty-icon { font-size: 58rpx; }

.empty-title {
  margin-top: 10rpx;
  color: #566177;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 8rpx;
  font-size: 23rpx;
}

.safe-bottom { height: calc(38rpx + env(safe-area-inset-bottom)); }
